Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 30
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Draw Behind: true
      Enabled: true
      Name: Saved Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Value: /map_updates
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: BENCH TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 500
      Name: BENCH Virtual Odometry
      Position Tolerance: 0.01
      Angle Tolerance: 0.01
      Shape:
        Alpha: 1
        Axes Length: 0.45
        Axes Radius: 0.025
        Color: 255; 255; 0
        Head Length: 0.15
        Head Radius: 0.07
        Shaft Length: 0.35
        Shaft Radius: 0.035
        Value: Axes
      Topic:
        Depth: 20
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /bench/odom
    - Class: rviz_default_plugins/Path
      Color: 255; 150; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: Parking Path
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /t_parking/planned_path
    - Class: rviz_default_plugins/Path
      Color: 40; 140; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Forward Path
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /t_parking/forward_path
    - Class: rviz_default_plugins/Path
      Color: 255; 60; 160
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Reverse Path
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /t_parking/reverse_path
    - Class: rviz_default_plugins/Path
      Color: 0; 255; 100
      Enabled: true
      Line Style: Lines
      Line Width: 0.025
      Name: Controller Received Plan
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /received_global_plan
    - Class: rviz_default_plugins/Path
      Color: 30; 144; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: Exit Path
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /t_parking/exit_path
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 18
      Target Frame: map
      X: 5.4
      Y: -3.9
