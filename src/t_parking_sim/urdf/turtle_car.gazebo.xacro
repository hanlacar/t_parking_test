<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Keep these joints in Gazebo's SDF conversion so the sensor frame survives. -->
  <gazebo reference="base_footprint_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="chassis_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="laser_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="rear_laser_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="chassis_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>

  <gazebo reference="front_left_steering_link">
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>
  <gazebo reference="front_right_steering_link">
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>

  <!-- High longitudinal grip and finite slip keep the car stable at parking speed. -->
  <gazebo reference="front_left_wheel_link">
    <mu1>1.25</mu1>
    <mu2>1.25</mu2>
    <kp>200000</kp>
    <kd>10</kd>
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>1.25</mu1>
    <mu2>1.25</mu2>
    <kp>200000</kp>
    <kd>10</kd>
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>1.35</mu1>
    <mu2>1.35</mu2>
    <kp>200000</kp>
    <kd>10</kd>
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>1.35</mu1>
    <mu2>1.35</mu2>
    <kp>200000</kp>
    <kd>10</kd>
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>

  <gazebo reference="laser_link">
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
    <sensor name="front_bumper_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <!-- Absolute topic makes the bridge mapping deterministic. -->
      <topic>/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>1440</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <!-- World visuals use the default all-bits flag; vehicle visuals use 1. -->
        <visibility_mask>2</visibility_mask>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="rear_laser_link">
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
    <sensor name="rear_bumper_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/scan_rear</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>1440</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <visibility_mask>2</visibility_mask>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!--
    Filename and class were verified with `gz plugin -i` against Gazebo Sim
    8.11.0. Only the two rear joints are driven; both front wheels remain
    freely rolling children of real steering joints.
  -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_separation>${wheel_track}</wheel_separation>
      <kingpin_width>${kingpin_width}</kingpin_width>
      <wheel_base>${wheel_base}</wheel_base>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <steering_limit>${steering_limit}</steering_limit>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.5</max_velocity>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <topic>/cmd_vel</topic>
      <!--
        AckermannSteering integrates commanded wheel motion, so its odometry
        continues through a physical collision.  Keep it available only as an
        unbridged diagnostic source; it must not own ROS /odom or /tf.
      -->
      <odom_topic>/wheel_odom</odom_topic>
      <tf_topic>/wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <steer_p_gain>10</steer_p_gain>
    </plugin>

    <!--
      Ground-truth model odometry reads Gazebo's world pose component, including
      collision response.  gazebo_pose_odom.py converts this absolute pose into
      the spawn-relative odom frame used throughout the project.
    -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>turtle_car</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/gazebo_ground_truth/odom_absolute</odom_topic>
      <tf_topic>/gazebo_ground_truth/tf_absolute</tf_topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
